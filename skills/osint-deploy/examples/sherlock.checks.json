{
  "tool": "sherlock", "stack": "uv-tool",
  "checks": [
    {"name":"help","tier":"T0","cmd":"sherlock --help","expect_regex":"usage: sherlock"},
    {"name":"version","tier":"T0","cmd":"sherlock --version","expect_regex":"Sherlock v[0-9]"},
    {"name":"unit-offline","tier":"T1","timeout":600,
     "cmd":"PATH=\"$HOME/osint_tools/src/sherlock/.venv/bin:$PATH\" $HOME/osint_tools/src/sherlock/.venv/bin/pytest -q -m 'not online' -p no:cacheprovider",
     "cwd":"~/osint_tools/src/sherlock","expect_regex":"[0-9]+ passed"},
    {"name":"readme-single-site","tier":"T2","network":true,"retry":1,"timeout":180,
     "cmd":"sherlock --site GitHub --print-found --no-color --timeout 20 torvalds","cwd":"/tmp",
     "expect_regex":"GitHub: https://www\\.github\\.com/torvalds"}
  ]
}
